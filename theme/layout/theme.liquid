<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_page != 1 %} – {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}

    {%- liquid
      assign heading_font = settings.type_heading_font
      assign body_font = settings.type_body_font
      assign body_font_medium = body_font | font_modify: 'weight', '500'
    -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}

    <style>
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_medium | font_face: font_display: 'swap' }}

      :root {
        --bg: {{ settings.color_bg }};
        --bg-2: {{ settings.color_bg_2 }};
        --ink: {{ settings.color_ink }};
        --ink-2: {{ settings.color_ink_2 }};
        --line: {{ settings.color_line }};
        --accent: {{ settings.color_accent }};
        --on-accent: {{ settings.color_on_accent }};
        --metal: {{ settings.color_metal }};
        --font-display: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        {%- if settings.color_bg_dark -%} color-scheme: dark;{%- endif %}
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="visually-hidden skip-link" href="#main">{{ 'general.skip' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        strings: {
          added: {{ 'products.added' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          addToCart: {{ 'products.add_to_cart' | t | json }},
          error: {{ 'cart.error' | t | json }}
        },
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
  </body>
</html>
