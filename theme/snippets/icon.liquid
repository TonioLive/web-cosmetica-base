{%- comment -%}
  Iconos de línea. Uso: {% render 'icon', icon: 'bag' %}
{%- endcomment -%}
<svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false" style="fill:none;stroke:currentColor;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round">
  {%- case icon -%}
    {%- when 'search' -%}
      <circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'bag' -%}
      <path d="M5 8h14l-1 13H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'menu' -%}
      <path d="M3 8h18M3 16h18"/>
    {%- when 'close' -%}
      <path d="M5 5l14 14M19 5 5 19"/>
  {%- endcase -%}
</svg>
