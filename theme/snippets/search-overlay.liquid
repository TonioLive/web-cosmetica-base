{%- comment -%}
  Búsqueda predictiva. theme.js pide los resultados a la sección «predictive-search»
  con la Predictive Search API; sin JavaScript el formulario va a /search.
{%- endcomment -%}
<div class="search" id="search" inert>
  <button type="button" class="drawer__backdrop" data-close tabindex="-1" aria-label="{{ 'search.close' | t }}"></button>
  <div class="search__panel" role="dialog" aria-modal="true" aria-label="{{ 'search.title' | t }}">
    <div class="wrap">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search__field">
        <label for="search-input" class="visually-hidden">{{ 'search.label' | t }}</label>
        <input id="search-input" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off" data-autofocus data-predictive-input>
        <input type="hidden" name="type" value="product">
        <button type="button" class="icon-btn" data-close aria-label="{{ 'search.close' | t }}">{% render 'icon', icon: 'close' %}</button>
      </form>
      <div class="search__results" id="search-results" aria-live="polite"></div>
    </div>
  </div>
</div>
