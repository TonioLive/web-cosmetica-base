{%- if section.settings.text != blank -%}
  <div class="announcement">
    <div class="wrap">
      <p>
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
        {%- else -%}
          {{ section.settings.text | escape }}
        {%- endif -%}
      </p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratuito y dos muestras en cada pedido" },
    { "type": "url", "id": "link", "label": "Enlace" }
  ],
  "presets": [{ "name": "Barra de anuncios" }]
}
{% endschema %}
