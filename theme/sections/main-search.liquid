<section class="section search-page">
  <div class="wrap">
    <header class="collection__head">
      <h1>{%- if search.performed -%}{{ 'search.results' | t: terms: search.terms }}{%- else -%}{{ 'search.title' | t }}{%- endif -%}</h1>
    </header>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search__field">
      <label for="search-page-input" class="visually-hidden">{{ 'search.label' | t }}</label>
      <input id="search-page-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn btn--ghost">{{ 'search.submit' | t }}</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        {%- if search.results_count > 0 -%}
          <div class="collection-grid" style="margin-top: 48px">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {%- assign uid = 'sr-' | append: forloop.index -%}
                {% render 'product-card', product: item, uid: uid %}
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
        {%- else -%}
          <p style="margin-top: 32px">{{ 'search.no_results' | t: terms: search.terms }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Resultados de búsqueda",
  "settings": []
}
{% endschema %}
