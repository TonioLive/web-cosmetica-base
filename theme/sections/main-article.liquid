<article class="section article">
  <div class="wrap">
    <header class="collection__head">
      <h1>{{ article.title | escape }}</h1>
      <p class="tnum">{{ article.published_at | time_tag: format: 'date' }}</p>
    </header>
    {%- if article.image -%}
      <div class="article__image">{{ article.image | image_url: width: 1600 | image_tag: sizes: '100vw', widths: '800, 1200, 1600', alt: article.title }}</div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{
  "name": "Artículo",
  "settings": []
}
{% endschema %}
