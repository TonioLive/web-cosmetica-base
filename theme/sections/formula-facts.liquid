{%- comment -%}
  «Lo que pone la etiqueta»: pestañas por producto con los datos de sus metacampos.
  Metacampos usados: custom.activos, custom.volumen, custom.pao_meses, custom.ph, custom.momento, custom.inci
{%- endcomment -%}
<section class="section facts" id="formula" data-tabs>
  <div class="wrap">
    <header class="section-head">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </header>
    <div class="facts__panel">
      <div class="facts__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          <button
            type="button"
            class="facts__tab"
            role="tab"
            id="tab-{{ block.id }}"
            aria-controls="panel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{- p.title | default: 'Producto' | escape -}}
          </button>
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <div class="facts__label" role="tabpanel" id="panel-{{ block.id }}" aria-labelledby="tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
          {%- if p != blank -%}
            <div class="facts__labelhead">
              <span class="facts__name">{{ p.title | escape }}</span>
              {%- if p.metafields.custom.volumen != blank -%}<span class="tnum">{{ p.metafields.custom.volumen.value | escape }} ℮</span>{%- endif -%}
            </div>
            {% render 'facts-table', product: p %}
            <div class="facts__meta">
              {%- if p.metafields.custom.pao_meses != blank -%}
                {%- assign months = p.metafields.custom.pao_meses.value -%}
                <span class="pao">
                  <svg class="pao-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M10 19h28l-3 22H13z" style="fill:none;stroke:currentColor;stroke-width:1.6"/><path d="M11 19l5-10h22l-1 10" style="fill:none;stroke:currentColor;stroke-width:1.6"/><text x="24" y="35" text-anchor="middle" style="font:500 10px var(--font-body);fill:currentColor">{{ months }}M</text></svg>
                  <span>{{ 'products.pao' | t: months: months }}</span>
                </span>
              {%- endif -%}
              {%- if p.metafields.custom.ph != blank -%}<span class="tnum">pH {{ p.metafields.custom.ph.value | escape }}</span>{%- endif -%}
              {%- if p.metafields.custom.momento != blank -%}<span>{{ p.metafields.custom.momento.value | escape }}</span>{%- endif -%}
            </div>
            {%- if p.metafields.custom.inci != blank -%}
              <p class="facts__inci"><strong>INCI.</strong> {{ p.metafields.custom.inci.value | escape }}</p>
            {%- endif -%}
          {%- else -%}
            <p>Elige un producto en el editor de temas.</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Etiqueta de fórmulas",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que pone la etiqueta" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Cada activo con su concentración. Si una cifra cambia en la fórmula, cambia aquí."
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "settings": [{ "type": "product", "id": "product", "label": "Producto" }]
    }
  ],
  "presets": [
    {
      "name": "Etiqueta de fórmulas",
      "blocks": [{ "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
