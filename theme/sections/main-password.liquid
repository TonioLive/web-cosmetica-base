{%- comment -%}
  Pre-lanzamiento: la tienda sigue protegida con contraseña y esta página recoge la lista de espera.
  Los correos entran en Clientes con las etiquetas configuradas.
{%- endcomment -%}
{%- liquid
  assign heading_lines = section.settings.heading | strip | newline_to_br | strip_newlines | split: '<br />'
  assign intensity = section.settings.intensity | divided_by: 100.0
-%}
<header class="wrap password__top">
  <span></span>
  <span class="wordmark">{{ settings.brand_name | default: shop.name | escape }}</span>
  <details class="password__enter">
    <summary>{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password', class: 'password__form' -%}
      <label for="storefront-password" class="visually-hidden">{{ 'password.password' | t }}</label>
      <div class="field-row">
        <input type="password" name="password" id="storefront-password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" required>
        <button type="submit" class="field-row__btn">{{ 'password.submit' | t }}</button>
      </div>
      {%- if form.errors -%}<p class="form-msg is-error" role="alert">{{ form.errors.messages['form'] }}</p>{%- endif -%}
    {%- endform -%}
  </details>
</header>

<section class="hero-drop hero-drop--password" data-hero-drop data-heading="{{ heading_lines | join: '|' | escape }}" data-intensity="{{ intensity }}" data-idle="true">
  <canvas class="hero-drop__canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="wrap hero-drop__headwrap">
    <h1 class="hero-drop__heading">
      {%- for line in heading_lines -%}<span>{{ line | strip | escape }}</span>{% unless forloop.last %} {% endunless %}{%- endfor -%}
    </h1>
  </div>
  <div class="wrap hero-drop__content">
    <div class="hero-drop__text">
      {%- if section.settings.lede != blank -%}<p class="hero-drop__lede">{{ section.settings.lede | escape }}</p>{%- endif -%}
      {% render 'waitlist-form', form_key: section.id, tags: section.settings.tags, success: section.settings.success %}
    </div>
    {%- if section.settings.date != blank -%}
      <div class="countdown" data-countdown="{{ section.settings.date | escape }}" aria-label="{{ 'countdown.label' | t }}">
        <div class="countdown__unit"><span class="countdown__num" data-cd="d">0</span><span class="countdown__lbl">{{ 'countdown.days' | t }}</span></div>
        <div class="countdown__unit"><span class="countdown__num" data-cd="h">00</span><span class="countdown__lbl">{{ 'countdown.hours' | t }}</span></div>
        <div class="countdown__unit"><span class="countdown__num" data-cd="m">00</span><span class="countdown__lbl">{{ 'countdown.minutes' | t }}</span></div>
      </div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'hero-drop.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Pre-lanzamiento",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Titular", "default": "Muy\npronto." },
    { "type": "text", "id": "lede", "label": "Texto", "default": "Lanzamos en febrero de 2027. Apúntate y te avisamos 48 horas antes." },
    { "type": "text", "id": "date", "label": "Fecha de lanzamiento", "info": "Formato AAAA-MM-DDTHH:MM:SS+01:00", "default": "2027-02-14T00:00:00+01:00" },
    { "type": "range", "id": "intensity", "label": "Refracción", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 120 },
    { "type": "text", "id": "tags", "label": "Etiquetas del cliente", "default": "newsletter,lista-espera,pre-lanzamiento" },
    { "type": "text", "id": "success", "label": "Mensaje de confirmación", "default": "Hecho. Te escribiremos 48 horas antes del lanzamiento." }
  ]
}
{% endschema %}
