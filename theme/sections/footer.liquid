<footer class="site-footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="wordmark" href="{{ routes.root_url }}">{{ settings.brand_name | default: shop.name | escape }}</a>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if settings.social_instagram != blank or settings.social_tiktok != blank -%}
          <p>
            {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a>{%- endif -%}
            {%- if settings.social_instagram != blank and settings.social_tiktok != blank %} · {% endif -%}
            {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a>{%- endif -%}
          </p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <nav class="footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading | escape }}</h3>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name | escape }}</p>
      {%- if section.settings.show_payment_icons -%}
        <ul class="payment-icons" role="list" aria-label="Métodos de pago">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto de marca",
      "default": "Cosmética de alta concentración."
    },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar métodos de pago", "default": true }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "menu",
      "name": "Columna de enlaces",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Ayuda" },
        { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
      ]
    }
  ],
  "presets": [{ "name": "Pie" }]
}
{% endschema %}
