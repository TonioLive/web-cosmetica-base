{%- comment -%}
  Productos complementarios (Product Recommendations API). Los complementarios se
  definen en la app gratuita Search & Discovery; si no hay, usa los relacionados.
{%- endcomment -%}
{%- assign url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=2&intent=' | append: section.settings.intent -%}
<section class="section complete" data-recommendations data-url="{{ url }}">
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="wrap">
      <header class="section-head">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </header>
      <div class="complete__grid">
        {%- for rec in recommendations.products -%}
          {%- assign uid = section.id | append: '-' | append: forloop.index -%}
          {% render 'product-card', product: rec, uid: uid %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Completa el ritual",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Completa el ritual" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Las fórmulas están pensadas para usarse juntas: primero la más ligera, después la más rica." },
    {
      "type": "select",
      "id": "intent",
      "label": "Tipo de recomendación",
      "options": [
        { "value": "complementary", "label": "Complementarios" },
        { "value": "related", "label": "Relacionados" }
      ],
      "default": "complementary"
    }
  ],
  "presets": [{ "name": "Completa el ritual" }]
}
{% endschema %}
